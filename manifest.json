{
  "manifest_version": 3,
  "name": "Omni WhatsApp Mic Max V4 Pro",
  "short_name": "WA Mic Max V4",
  "version": "4.3.0",
  "description": "Chromium-compatible WhatsApp Web microphone enhancer with safe WebRTC hooks for one-to-one, group, and community calls.",
  "permissions": ["storage"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content/loader.js", "content/service.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["core/injector.js"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ],
  "action": {
    "default_title": "Omni WhatsApp Mic Max V4 Pro",
    "default_popup": "popup/popup.html"
  },
  "minimum_chrome_version": "109"
}
